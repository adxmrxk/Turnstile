{
  "realm": "turnstile",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "buyer", "description": "Can buy seats" },
      { "name": "staff", "description": "Venue staff: can read the raw log, the audit and seat history" }
    ]
  },
  "clients": [
    {
      "clientId": "turnstile-web",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:8080/*"],
      "webOrigins": ["http://localhost:8080"]
    }
  ],
  "users": [
    {
      "username": "buyer1",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "buyer1-dev-only", "temporary": false }],
      "realmRoles": ["buyer"]
    },
    {
      "username": "staff1",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "staff1-dev-only", "temporary": false }],
      "realmRoles": ["staff", "buyer"]
    }
  ]
}
